# Hanya dipakai kalau site.config.ts → mode: 'supabase'
# Salin file ini menjadi .env lalu isi nilainya.
# Cari di Supabase: Project Settings → API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJ...isi-dengan-anon-public-key...

# (Opsional) tombol "Auto Generate AI" di admin. Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
